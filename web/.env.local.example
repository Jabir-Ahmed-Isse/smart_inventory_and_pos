# Supabase — copy to .env.local and fill from your project's API settings.
# Project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe to expose to the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role (secret) key — SERVER ONLY, NEVER expose to the browser.
# Required for admin-driven user creation (platform console + "Create User").
# Find it in Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
