# Smart Inventory & POS — environment variables
# Copy to .env.local for local dev, or set these in Vercel → Project → Settings → Environment Variables.

# --- Supabase (required) ---------------------------------------------------
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — SERVER ONLY (never expose to the browser). Used by the
# platform-admin flow to create companies + owner accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# --- AI (optional) ---------------------------------------------------------
# Google AI Studio key (aistudio.google.com). Enables live AI answers; without
# it the app uses the built-in deterministic analyst (still grounded in data).
GEMINI_API_KEY=your-gemini-key
# Model to use. gemini-flash-latest is verified working; 2.0-flash may rate-limit.
GEMINI_MODEL=gemini-flash-latest
# Alternative to GEMINI_API_KEY (same purpose).
# GOOGLE_API_KEY=

# Anthropic Claude — used as a fallback if Gemini isn't set/failing.
# ANTHROPIC_API_KEY=sk-ant-...

# --- AI Business Report Agent ----------------------------------------------
# Secret protecting the scheduler endpoint (/api/cron/reports). Without it the
# endpoint refuses to run (it is never open).
#   • Vercel Cron (production): set CRON_SECRET — Vercel automatically sends it as
#     "Authorization: Bearer <CRON_SECRET>" on every scheduled call. The cron
#     schedule lives in web/vercel.json. On the FREE Hobby plan it runs ONCE
#     PER DAY (0 5 * * * = 05:00 UTC ≈ 08:00 East Africa); the endpoint then
#     generates each enabled org's due report for the completed period, in the
#     org's own timezone, idempotently (no duplicates).
#     On Vercel Pro you may use a frequent schedule (e.g. "*/15 * * * *") plus
#     "path": "/api/cron/reports?strict=1" to honor each org's exact time.
#   • Other schedulers: call https://YOUR-APP/api/cron/reports?secret=THIS_VALUE
# CRON_SECRET is preferred; REPORTS_CRON_SECRET is accepted as a legacy fallback.
CRON_SECRET=change-me-to-a-long-random-string
# REPORTS_CRON_SECRET=

# WhatsApp delivery (optional). If unset, WhatsApp shows "Not configured" and
# is skipped — never faked. Pick ONE provider style:
#   WHATSAPP_PROVIDER=meta     → Meta WhatsApp Cloud API (needs SENDER=phone_number_id + a Cloud API token)
#   WHATSAPP_PROVIDER=twilio   → Twilio WhatsApp (needs ACCOUNT_SID + API_TOKEN=Auth Token + SENDER=whatsapp number)
#   WHATSAPP_PROVIDER=greenapi → GREEN-API gateway (needs GREENAPI_ID_INSTANCE + API_TOKEN=apiTokenInstance); free, global
#   WHATSAPP_PROVIDER=callmebot→ CallMeBot free personal API (needs API_TOKEN=apikey); only messages the number that granted the key
#   WHATSAPP_PROVIDER=generic  → POST {to,from,text} to your own WHATSAPP_API_URL
# WHATSAPP_PROVIDER=mock
# WHATSAPP_API_TOKEN=          # Meta: Cloud API token · Twilio: Auth Token · GREEN-API: apiTokenInstance · CallMeBot: your apikey
# WHATSAPP_API_URL=            # generic provider · GREEN-API: optional base override (default https://api.green-api.com)
# WHATSAPP_SENDER=             # Meta: the Phone number ID (NOT the phone) · Twilio: the WhatsApp number e.g. +14155238886
# WHATSAPP_ACCOUNT_SID=        # Twilio only: your Account SID (starts with AC...)
# WHATSAPP_GREENAPI_ID_INSTANCE=   # GREEN-API only: your instance id (idInstance)
#
# Meta report TEMPLATE (required for PROACTIVE daily/weekly reports — free-form
# text only reaches a user within 24h of them messaging you). Create + get this
# template approved in Meta, then set its name here. It must have 6 body vars
# {{1}}..{{6}} = period, sales, payments, profit, inventory, action.
# WHATSAPP_TEMPLATE_NAME=inventory_report
# WHATSAPP_TEMPLATE_LANG=en_US

# Email delivery (optional). SMTP — works with Gmail or any provider. If unset,
# Email is skipped, never faked. For Gmail: enable 2-Step Verification, then
# create an App Password at myaccount.google.com/apppasswords and use it as SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true             # true for port 465, false for 587 (STARTTLS)
# SMTP_USER=you@gmail.com      # your Gmail address
# SMTP_PASS=your_app_password  # the 16-char Google App Password (NOT your login password)
# SMTP_FROM=you@gmail.com      # optional; defaults to SMTP_USER
# REPORT_EMAIL_TO=you@gmail.com  # where reports are sent; defaults to SMTP_USER
